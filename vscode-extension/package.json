{
  "name": "editormate-vscode",
  "displayName": "EditorMate",
  "description": "Show EditorMate pairing QR and session management in VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.79.0",
    "typescript": "^5.0.0",
    "vscode-test": "^2.0.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "editormate.showPairing",
        "title": "EditorMate: Show Pairing QR"
      }
    ]
  }
}