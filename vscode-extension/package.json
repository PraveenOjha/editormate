{
  "name": "editormate-vscode",
  "displayName": "EditorMate",
  "description": "Show EditorMate pairing QR and session management in VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": ["*"],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "build": "npm run compile",
    "watch": "tsc -watch -p ./",
    "dev": "npm run watch",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "node-fetch": "^2.6.7",
    "eventsource": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.79.0",
    "typescript": "^5.0.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "editormate.showPairing",
        "title": "EditorMate: Show Pairing QR"
      },
      {
        "command": "editormate.openChat",
        "title": "EditorMate: Open Chat"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "editormate",
          "title": "EditorMate",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "editormate": [
        {
          "id": "editormate.pairingView",
          "name": "Pairing"
        }
      ]
    },
    "commands": [
      {
        "command": "editormate.selectChatToTrack",
        "title": "EditorMate: Select Chat to Track"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "EditorMate",
      "properties": {
        "editormate.autoStartAgent": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start EditorMate agent when the host is not detected and this workspace has an agent folder."
        }
      }
    }
  }
}